DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-in-production-to-a-random-64-char-string"
PORT=3001

# Comma-separated origins allowed for CORS (dev default: Vite on 5173)
# CORS_ORIGIN=http://localhost:5173

# Production only — path to built client assets (Docker sets this automatically)
# CLIENT_DIST_PATH=../../client/dist
